{
  "name": "finance-tracker-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "news": "cadence news build -o frontend/public/nouveautes-data",
    "plan": "node frontend/scripts/plan-data.mjs --in docs/plan/raf.yaml --news docs/nouveautes --out frontend/public/plan-data/plan.json"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
