# Finance Tracker — Backend env (NestJS)
# Copie ce fichier en .env et remplis les valeurs.

# Port d'écoute
PORT=3000

# Mode (production | development)
NODE_ENV=production

# PIN de protection (4-8 chiffres, gardé en sessionStorage côté frontend)
APP_PIN=0000

# Origine autorisée pour le CORS (URL du frontend)
CORS_ORIGIN=http://localhost:4200

# Clé API Anthropic — nécessaire pour l'analyse PDF Claude
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Suggestions de règles de catégorisation : claude | ollama
# Ollama est utile ici car le flux est text-only et reste dans le LAN.
CATEGORY_RULE_SUGGESTIONS_PROVIDER=claude
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Dossier des données (montés en volume Docker)
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads

# Taille max d'un PDF de relevé (Mo)
MAX_FILE_SIZE_MB=20

# Hôtes publics forcés en mode démo verrouillée.
# Lecture autorisée sur le dataset demo, écritures bloquées (403), sauf
# POST /api/demo/seed qui initialise le jeu fictif si nécessaire.
DEMO_FORCED_HOSTS=trycloudflare.com,cfargotunnel.com,finance.sladoire.dev
